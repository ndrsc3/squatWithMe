{
    "name": "squat-with-me",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "dev:check": "node scripts/dev-check.mjs",
        "dev:full": "node scripts/dev-check.mjs && vercel dev",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "smoke": "node scripts/smoke-api.mjs",
        "lint": "eslint src/ api/ vite.config.ts",
        "format": "prettier --write src/ api/ vite.config.ts *.json",
        "e2e": "playwright test",
        "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run smoke",
        "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@playwright/test": "^1.64.1",
        "@types/node": "^20.11.0",
        "@vercel/node": "^5.1.7",
        "eslint": "^9.0.0",
        "eslint-config-prettier": "^10.0.0",
        "jiti": "^2.6.1",
        "prettier": "^3.0.0",
        "rimraf": "^5.0.5",
        "tsx": "^4.0.0",
        "typescript": "^5.3.3",
        "typescript-eslint": "^8.0.0",
        "vite": "^6.0.0",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@neondatabase/serverless": "^1.1.0",
        "jose": "^6.2.8"
    }
}
